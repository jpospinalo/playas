# 1) Entorno virtual
.venv/
venv/

# 2) Cachés y archivos temporales de Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
.eggs/

# 3) Configuración de IDE / editor
.vscode/
.idea/
*.swp
*.swo

# 4) Datos generados por el pipeline
data/*
data/raw/
data/bronze/
data/silver/
data/gold/
!data/*.jsonl.gz
!data/import_to_chromadb.py
!data/seed_users.sql

# 5) Resultados de evaluación (pueden contener datos sensibles)
evaluation/ragas_eval_dataset.json
evaluation/ragas_eval_summary.json
# C6/8.3 — evidencia generada por los diagnósticos offline de Ola C
# (rrf_diagnostic.py, citation_coverage.py): reproducible a partir de los
# scripts versionados, no se versiona el JSON de salida en sí. Patrón
# acotado a propósito a *_report.json dentro de evaluation/ — no un patrón
# más amplio que pudiera ocultar datasets o fuentes también versionados ahí.
rag/evaluation/*_report.json

# 6) Configuración sensible / secretos
.env*
!.env.example
*.pem
*.key
*.crt
firebase-service-account.json
*-service-account.json

# 7) Archivos de sistema
.DS_Store
Thumbs.db

# 8) Cobertura y testing
htmlcov/
.coverage
coverage.xml

# 9) Skills
skills/
skills-lock.json

# 10) Frontend
node_modules/
dist/

# 11) Terraform state
*tfstate*
.terraform/
*.tfvars
!*.tfvars.example

# 12) Claude
settings.local.json

# 13) Backups del bucket S3
bucket-backup-*/
# Local Pi runtime state
.atl/
.pi/
.pi-lens/

# Archivos normativos locales (no deben subirse al repo)
archivos-normativa/

# 14) Documentos Word del ground-truth (binarios generados; solo se versiona el Markdown)
docs/ground-truth/*.docx
ARCHITECTURE_ANALYSIS.md

# 15) Carpeta temporal de sincronización usada por Claude para revisiones — no debe versionarse
_claude_sync/

# 16) Binarios de terceros descargados (instaladores, plugins) — no deben versionarse
*.deb
session-manager-plugin.deb
