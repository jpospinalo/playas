+/**
+ * Configuración compartida del frontend.
+ *
+ * IMPORTANTE: usa `||`, no `??`. Si NEXT_PUBLIC_API_URL existe pero está
+ * vacía (como en el .env.example, pensado para despliegues Docker/nginx
+ * con rutas relativas), `??` NO activa el fallback porque "" no es
+ * null/undefined — y las peticiones terminan pegándole al propio origen
+ * del frontend en vez del backend.
+ */
+export const API_URL =
+	process.env.NEXT_PUBLIC_API_URL || "http://localhost:8080";
