# Node 24 "Krypton" (LTS hasta 2028-04-30). Node 20 dejó de tener soporte el
# 2026-04-30 (TRV-02). Tag y digest fijados el 2026-10-22: node:24-alpine =
# node:24.22.1-alpine en Docker Hub.
# Stage 1: build
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

WORKDIR /app

RUN npm install -g bun@1.3.13 --quiet

ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY package.json bun.lock* ./
COPY frontend/ ./frontend/

RUN bun install --frozen-lockfile

WORKDIR /app/frontend
RUN node_modules/.bin/next build

# Stage 2: runner (standalone — sin node_modules externos)
# Next.js con output:"standalone" genera .next/standalone/ con todo lo necesario.
# La ruta de server.js refleja la estructura del workspace: frontend/server.js.
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runner

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

WORKDIR /app

# standalone incluye server.js, node_modules y package.json bajo frontend/
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
# assets estáticos deben estar junto a server.js en frontend/.next/static/
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./frontend/.next/static
# archivos públicos
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./frontend/public

USER nextjs

EXPOSE 3000

WORKDIR /app/frontend
CMD ["node", "server.js"]
