
# ── RAG_ENV_FILE (opcional, no forma parte de la configuración de negocio) ──
# rag/backend/rag/config.py resuelve qué .env cargar en este orden:
# 1. RAG_ENV_FILE, si está definida — debe apuntar a un archivo .env
#    existente, o config.py falla al importar (a propósito: evita continuar
#    en silencio con una configuración distinta a la que se pidió).
# 2. .env en el directorio de trabajo actual.
# 3. .env en la raíz de este workspace (rag/), localizado automáticamente.
# La mayoría de casos (make, uv run desde rag/) no necesita definirla — se
# usa sobre todo para tests que necesitan un .env aislado y reproducible, o
# para apuntar explícitamente a un archivo distinto al de este ejemplo. No
# se documenta aquí ninguna ruta real: cada quien apunta a la suya.
# RAG_ENV_FILE=

# Frontend — URL del backend
# En local: http://localhost:8080 | Con docker compose (nginx): /api
NEXT_PUBLIC_API_URL=

# ── AWS S3 (almacenamiento centralizado del pipeline de datos)
S3_BUCKET_NAME=

# Gemini
GOOGLE_API_KEY=tu_api_key_de_google
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (tiene máxima prioridad si está definida)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# OpenRouter (segunda prioridad, sobre Gemini)
# Obtén tu clave en: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-5.4-mini

# ── JWT (autenticación propia) ────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_playas

# Embeddings (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

# Reranker (opcional, también con Ollama; OllamaReranker en core/retriever.py,
# no usado en el flujo principal). Sin valor por defecto en config.py: para
# activarlo hacen falta AMBAS variables — OLLAMA_RERANK_BASE_URL y
# OLLAMA_RERANK_MODEL (o su alias legado OLLAMA_RERANKER_MODEL, que se deja
# abajo por compatibilidad con quien ya lo tenga así). No hay una URL de
# ejemplo real que poner aquí: dejar OLLAMA_RERANK_BASE_URL vacía si no vas a
# usar el reranker.
OLLAMA_RERANK_BASE_URL=
OLLAMA_RERANKER_MODEL=llama3.2:3b

# ── Enriquecimiento de consultas ─────────────────────────────────────────────
# Activa el paso de reescritura de la consulta del usuario antes de la recuperación.
# El LLM enriquece la query con terminología jurídica precisa para mejorar el
# recall del retriever híbrido BM25 + vector.
QUERY_ENRICHMENT_ENABLED=true

# delay gemma
RAGAS_LLM_DELAY=20.0
# Protección de los endpoints /api/query y /api/query/stream.
# off conserva el comportamiento actual; observe solo registra excesos.
RAG_RATE_LIMIT_MODE=off
RAG_RATE_LIMIT_REQUESTS=10
RAG_RATE_LIMIT_WINDOW_SECONDS=60

# Protección del endpoint /api/conversations/generate-title. Límite
# independiente del de consultas RAG. off conserva el comportamiento actual.
TITLE_RATE_LIMIT_MODE=off
TITLE_RATE_LIMIT_REQUESTS=5
TITLE_RATE_LIMIT_WINDOW_SECONDS=60

# Protección del endpoint /api/auth/login (clave = email normalizado + IP de
# origen). off conserva el comportamiento actual. No activar enforce detrás
# de un proxy/LB sin antes revisar la política de IP de origen usada.
AUTH_RATE_LIMIT_MODE=off
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Límite de concurrencia global de proceso para /api/query y
# /api/query/stream (T3.6) — distinto de los rate limiters de arriba: no
# limita por usuario/IP/ventana de tiempo, sino cuántas consultas pueden
# estar en vuelo simultáneamente en todo el proceso. off conserva el
# comportamiento actual (sin overhead). Los valores de abajo son los mismos
# que usa config.py por defecto si esta sección no está presente.
RAG_BACKPRESSURE_MODE=off
RAG_BACKPRESSURE_MAX_CONCURRENT=20

# ── Evaluación ──────────────────────────────────────────────────────────────
# Segunda API key para el juez RAGAS (evita conflictos de rate-limit con el pipeline)
GOOGLE_API_KEY2=

# Evaluación con Ollama remoto (e.g., ngrok tunnel)
OLLAMA_EVAL_BASE_URL=http://localhost:11434
OLLAMA_EVAL_MODEL=mistral
