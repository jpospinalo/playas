
# ── RAG_ENV_FILE (opcional, no forma parte de la configuración de negocio) ──
# rag/backend/rag/config.py resuelve qué .env cargar en este orden:
# 1. RAG_ENV_FILE, si está definida — debe apuntar a un archivo .env
#    existente, o config.py falla al importar (a propósito: evita continuar
#    en silencio con una configuración distinta a la que se pidió).
# 2. .env en el directorio de trabajo actual.
# 3. .env en la raíz de este workspace (rag/), localizado automáticamente.
# La mayoría de casos (make, uv run desde rag/) no necesita definirla — se
# usa sobre todo para tests que necesitan un .env aislado y reproducible, o
# para apuntar explícitamente a un archivo distinto al de este ejemplo. No
# se documenta aquí ninguna ruta real: cada quien apunta a la suya.
# RAG_ENV_FILE=

# Frontend — URL del backend
# En local: http://localhost:8080 | Con docker compose (nginx delante):
# déjala vacía, para que el frontend use rutas relativas y nginx las
# enrute a /api/ (ver rag/docker/nginx.conf).
NEXT_PUBLIC_API_URL=

# ── AWS S3 (almacenamiento centralizado del pipeline de datos)
S3_BUCKET_NAME=

# Gemini
GOOGLE_API_KEY=tu_api_key_de_google
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (tiene máxima prioridad si está definida)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# OpenRouter (segunda prioridad, sobre Gemini)
# Obtén tu clave en: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-5.4-mini

# ── JWT (autenticación propia) ────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Máximo de operaciones bcrypt simultáneas por proceso.
PASSWORD_HASH_MAX_CONCURRENT=2

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_playas

# Embeddings (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

# Reranker (opcional, también con Ollama; OllamaReranker en core/retriever.py,
# no usado en el flujo principal). Sin valor por defecto en config.py: para
# activarlo hacen falta AMBAS variables — OLLAMA_RERANK_BASE_URL y
# OLLAMA_RERANK_MODEL (o su alias legado OLLAMA_RERANKER_MODEL, que se deja
# abajo por compatibilidad con quien ya lo tenga así). No hay una URL de
# ejemplo real que poner aquí: dejar OLLAMA_RERANK_BASE_URL vacía si no vas a
# usar el reranker.
OLLAMA_RERANK_BASE_URL=
OLLAMA_RERANKER_MODEL=llama3.2:3b

# ── Enriquecimiento de consultas ─────────────────────────────────────────────
# Activa el paso de reescritura de la consulta del usuario antes de la recuperación.
# El LLM enriquece la query con terminología jurídica precisa para mejorar el
# recall del retriever híbrido BM25 + vector.
QUERY_ENRICHMENT_ENABLED=true

# delay gemma
RAGAS_LLM_DELAY=20.0
# Protección de los endpoints /api/query y /api/query/stream.
# off conserva el comportamiento actual; observe solo registra excesos.
RAG_RATE_LIMIT_MODE=off
RAG_RATE_LIMIT_REQUESTS=10
RAG_RATE_LIMIT_WINDOW_SECONDS=60

# Protección del endpoint /api/conversations/generate-title. Límite
# independiente del de consultas RAG. off conserva el comportamiento actual.
TITLE_RATE_LIMIT_MODE=off
TITLE_RATE_LIMIT_REQUESTS=5
TITLE_RATE_LIMIT_WINDOW_SECONDS=60

# Protección del endpoint /api/auth/login (clave = email normalizado + IP de
# origen). off conserva el comportamiento actual. No activar enforce detrás
# de un proxy/LB sin antes revisar la política de IP de origen usada.
AUTH_RATE_LIMIT_MODE=off
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Límite de concurrencia global de proceso para /api/query y
# /api/query/stream — distinto de los rate limiters de arriba: no
# limita por usuario/IP/ventana de tiempo, sino cuántas consultas pueden
# estar en vuelo simultáneamente en todo el proceso. off conserva el
# comportamiento actual (sin overhead). Los valores de abajo son los mismos
# que usa config.py por defecto si esta sección no está presente.
RAG_BACKPRESSURE_MODE=off
RAG_BACKPRESSURE_MAX_CONCURRENT=20

# Timeouts de /api/query y /api/query/stream. El ALB/Nginx delante de este
# servicio tienen 300s de timeout de INACTIVIDAD (sin bytes nuevos en la
# conexión), no un límite total — estos valores producen un corte
# controlado (504 JSON / evento SSE de error) unos segundos antes de eso.
# No bajar estos valores en despliegue sin calibrar primero con datos
# reales de producción; usar valores pequeños solo en pruebas.
#
# RAG_QUERY_TOTAL_TIMEOUT_SECONDS: /api/query (JSON) — timeout TOTAL de
# graph.ainvoke(...) (enrich → retrieve → generate en conjunto).
RAG_QUERY_TOTAL_TIMEOUT_SECONDS=280
# RAG_QUERY_STREAM_STAGE_TIMEOUT_SECONDS: /api/query/stream (SSE) — NO es un
# timeout total ni tres timeouts independientes por etapa (enrich/retrieve/
# generate). Mide la INACTIVIDAD máxima entre dos eventos consecutivos que
# el grafo produce; cada evento nuevo (status intermedio o final) reinicia
# la cuenta. Una consulta SSE legítima puede durar más que este valor si
# sigue produciendo eventos — solo se corta si deja de producir CUALQUIER
# evento nuevo durante este tiempo.
RAG_QUERY_STREAM_STAGE_TIMEOUT_SECONDS=285

# Umbral (en caracteres del prompt de generación ya formateado) por encima
# del cual se emite un warning estructurado en los logs — solo observación,
# no trunca contexto ni respuestas, y no cambia ningún límite de tokens de
# generación.
RAG_CONTEXT_BUDGET_WARNING_CHARS=80000

# ── Evaluación ──────────────────────────────────────────────────────────────
# Evaluación reproducible con RAGAS sobre el dataset versionado
# evaluation/data/legal-ground-truth-v0.1.json (21 preguntas jurídicas;
# cargador y validación en evaluation/ground_truth.py). Dos jueces
# intercambiables, misma infraestructura compartida en
# evaluation/ragas_common.py:
#
#   uv run python -m evaluation.ragas_eval_gemma                  # juez Gemini
#   uv run python -m evaluation.ragas_eval_ollama                 # juez Ollama
#   uv run python -m evaluation.ragas_eval_gemma  --validate-only # sin red/LLM
#   uv run python -m evaluation.ragas_eval_ollama --validate-only # sin red/LLM
#
# Cada corrida real escribe un reporte reproducible (dataset, sha256, estado
# git -- commit y si el árbol tenía cambios sin commit --, métricas por
# caso, casos, errores) en evaluation/results/ (no versionado, ver
# evaluation/.gitignore) — no en las variables de abajo. Detalle completo
# del formato del reporte y de las métricas reales por proveedor en
# docs/SCRIPTS.md#evaluación-del-rag.

# Juez Gemini (evaluation/ragas_eval_gemma.py). GEMINI_MODEL aquí es el
# modelo que actúa como juez de evaluación, no el que genera las respuestas
# del RAG (ese es rag.config.GEMINI_MODEL / GEMINI_MODEL de la sección
# "Gemini" más arriba) — pueden diferir intencionalmente; el valor por
# defecto del juez es "gemma-3-27b-it" si esta variable no está definida.
# GOOGLE_API_KEY2 es una segunda API key para el juez (evita conflictos de
# rate-limit con el pipeline de producción, que usa GOOGLE_API_KEY).
GOOGLE_API_KEY2=

# Juez Ollama (evaluation/ragas_eval_ollama.py) — un servidor Ollama de
# evaluación, normalmente distinto del OLLAMA_BASE_URL de embeddings de
# producción (sección "Embeddings" más arriba, que sí reutiliza este
# adaptador para sus embeddings). Ambas variables son obligatorias para este
# adaptador: sin valor por defecto.
OLLAMA_EVAL_BASE_URL=http://localhost:11434
OLLAMA_EVAL_MODEL=mistral
