# ── Firebase ─────────────────────────────────────────────────────────────────
# Backend — ruta al JSON del service account, relativa al directorio rag/
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Frontend — SDK Web (Configuración del proyecto → Tus apps → SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Frontend — URL del backend
# En local: http://localhost:8080 | Con docker compose (nginx): /api
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── LLM ──────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=tu_api_key_de_google
GEMINI_MODEL=gemini-3.1-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-5.4-mini

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_playas

# ── Embeddings y reranker (Ollama) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_RERANKER_MODEL=llama3.2:3b

# ── Enriquecimiento de consultas ─────────────────────────────────────────────
QUERY_ENRICHMENT_ENABLED=true
QUERY_ENRICHMENT_HYDE=false

# ── Evaluación (RAGAS) ───────────────────────────────────────────────────────
RAGAS_LLM_DELAY=20.0
RATE_LIMIT_SECONDS=20.0
GOOGLE_API_KEY2=
OLLAMA_EVAL_BASE_URL=http://localhost:11434
OLLAMA_EVAL_MODEL=mistral
