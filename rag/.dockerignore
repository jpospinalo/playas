# ── Entornos virtuales y caché ────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Datos del pipeline (no se necesitan en runtime) ───────────────────────────
evaluation/
tests/
docs/
infrastructure/
scripts/
utils/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Secretos (nunca dentro de la imagen) ─────────────────────────────────────
.env
.env.*
.env.example
firebase-service-account.json

# ── Herramientas locales ──────────────────────────────────────────────────────
.pi/
.impeccable/
