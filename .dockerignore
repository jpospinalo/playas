rag/backend/rag/tools/
rag/backend/tests/

# ── Frontend (tiene su propio contexto de build) ──────────────────────────────
rag/frontend/
node_modules/

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Secretos (nunca dentro de la imagen) ─────────────────────────────────────
