# ── Object Storage Compartido (ingest + rag/backend) ────────────────────────
# Si `S3_ENDPOINT_URL` queda vacío, boto3 usa AWS S3 (rellena las llaves AWS).
# Para MinIO local, usa endpoint explícito + path style.
# Credenciales de ejemplo: cámbialas en cualquier entorno real.
S3_BUCKET_NAME=rag-playas-data
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_SESSION_TOKEN=
S3_ADDRESSING_STYLE=path
S3_VERIFY_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Ingesta ──────────────────────────────────────────────────────────────────
INGEST_RUN_INDEXER=true

# ── Backend RAG ──────────────────────────────────────────────────────────────
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_playas
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_RERANKER_MODEL=llama3.2:3b
QUERY_ENRICHMENT_ENABLED=true
QUERY_ENRICHMENT_HYDE=false
DEFAULT_K=4
DEFAULT_K_CANDIDATES=10
CONTEXT_LIMIT_TOKENS=200000

# ── Firebase Admin SDK (Service Account, backend) ────────────────────────────
# Cada campo del JSON del service account como variable separada (ideal para
# Railway). La clave privada va en UNA línea, con saltos como "\n" literales y
# SIN comillas — el backend los convierte a saltos reales.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_PRIVATE_KEY_ID=tu_private_key_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...firma...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=tu_client_id
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40tu-proyecto.iam.gserviceaccount.com
# Alternativa para desarrollo local: ruta al JSON. Solo se usa si NO defines las
# variables de arriba (FIREBASE_PROJECT_ID / FIREBASE_PRIVATE_KEY / FIREBASE_CLIENT_EMAIL).
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_FIREBASE_API_KEY=tu_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_firebase_app_id

# ── Proveedores LLM ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=tu_google_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=tu_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ENRICHER_MODEL=gpt-5.4-mini
OPENROUTER_API_KEY=tu_openrouter_api_key
OPENROUTER_MODEL=gpt-5.4-mini
OPENROUTER_ENRICHER_MODEL=gpt-5.4-mini

# ── Evaluación / Operación ───────────────────────────────────────────────────
RAGAS_LLM_DELAY=20.0
RATE_LIMIT_SECONDS=20.0
GOOGLE_API_KEY2=tu_google_api_key_secundaria
OLLAMA_EVAL_BASE_URL=http://localhost:11434
OLLAMA_EVAL_MODEL=mistral
