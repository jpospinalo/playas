# Copiar a demo.env y ajustar. NO poner claves AWS aquí: los scripts usan el perfil
# configurado con `aws configure` (o las variables de la sesión del laboratorio).
REGION=us-east-1
CUENTA_ESPERADA=679786170402
# Instancias del demo (se inician/detienen; nunca se terminan).
ID_OLLAMA=i-03c5de31fb6f876b3
