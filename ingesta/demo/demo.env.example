# Buzón S3 privado creado con infrastructure/intake/crear_bucket.sh
BUCKET=atlas-demo-intake-679786170402
# Colección del demo en el Chroma local del worker (prefijo atlas_demo_ obligatorio).
COLECCION=atlas_demo_base
# Clave SSH del laboratorio (vockey) para consultar el worker.
CLAVE_SSH=$HOME/labsuser.pem
